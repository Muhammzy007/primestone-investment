{
  "name": "primestone-investment-backend",
  "version": "1.0.0",
  "description": "PrimeStone Investment Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:full": "concurrently \"npm run dev\" \"cd ../frontend && npm start\"",
    "build": "cd ../frontend && npm run build",
    "prod": "npm run build && NODE_ENV=production node server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.9.0",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "express-validator": "^7.0.1",
    "nodemailer": "^6.9.4",
    "qrcode": "^1.5.3",
    "node-cron": "^3.0.2",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}
